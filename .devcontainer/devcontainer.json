{
  "name": "FrameForge — browser development",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    }
  },
  "postCreateCommand": "corepack enable && pnpm install --no-frozen-lockfile && python -m pip install -r apps/api/requirements-dev.txt",
  "forwardPorts": [
    3000,
    8000
  ],
  "portsAttributes": {
    "3000": {
      "label": "FrameForge editor",
      "onAutoForward": "openBrowser"
    },
    "8000": {
      "label": "FastAPI",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
